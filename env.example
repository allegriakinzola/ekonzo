# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/ekonzo"

# Better Auth
BETTER_AUTH_SECRET="changez-ce-secret-en-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# URL publique Next.js (exposée au browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Africa's Talking (SMS OTP) — optionnel en développement
AT_USERNAME=""
AT_API_KEY=""

# KYC Provider : "manual" (défaut) ou "aws"
KYC_PROVIDER="manual"

# AWS KYC — requis si KYC_PROVIDER=aws
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
