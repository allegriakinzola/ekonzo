# ══════════════════════════════════════════════════════════════════════════
# ekonzo — variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs
#   Windows PowerShell:  Copy-Item env.template .env
# ══════════════════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ekonzo?schema=public"

# ── Better Auth ────────────────────────────────────────────────────────────
# Générer le secret: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Application ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── EasyPay (passerelle Mobile Money) ──────────────────────────────────────
# Clés : https://merchant.e-com-easypay.com → Espace Développeur
# MODE : sandbox | v1
PAYMENT_PROVIDER=easypay
EASYPAY_MODE="sandbox"
EASYPAY_CID=""
EASYPAY_TOKEN=""
# URL IPN publique (EasyPay ne peut PAS joindre localhost).
# En local : tunnel (ngrok) → https://xxxx.ngrok.io/api/payments/ipn
# En prod  : https://votre-domaine.com/api/payments/ipn
# Configurer AUSSI cette URL dans le dashboard marchand EasyPay (IPN).
EASYPAY_CALLBACK_URL="https://votre-domaine.com/api/payments/ipn"

# ── Banques partenaires ────────────────────────────────────────────────────
# La sélection se fait dans l'UI (Equity BCDC pour commencer).
# PARTNER_BANK_NAME n'est plus requis pour la signature.
#
# Logos : par défaut stockés en base (data-URL) — durables en production.
# Option S3 (clés AWS déjà utilisées pour le KYC) :
# AWS_S3_BUCKET=""
# AWS_S3_PUBLIC_URL="https://votre-bucket.s3.amazonaws.com"
# AWS_REGION=us-east-1

# ── SMS OTP (Africa's Talking) ──────────────────────────────────────────────
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID="ekonzo"
