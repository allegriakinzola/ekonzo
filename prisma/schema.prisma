// ekonzo — schéma de base de données
// Plateforme de souscription aux Bons et Obligations du Trésor de la RDC
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════════════════
// BETTER AUTH — tables gérées par la librairie d'authentification
// ══════════════════════════════════════════════════════════════════════════

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String?   @unique
  emailVerified       Boolean   @default(false)
  image               String?
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                UserRole  @default(CLIENT)
  kycStatus           KYCStatus @default(PENDING)
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  kyc           KYC?
  wallets       Wallet[]
  momoAccounts  MomoAccount[]
  bankAccounts  BankAccount[]
  subscriptions           Subscription[]
  transactions            Transaction[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  securitiesAgreements    SecuritiesAccountAgreement[]
  settlementProfile       SettlementProfile?

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ══════════════════════════════════════════════════════════════════════════
// KYC — vérification d'identité
// ══════════════════════════════════════════════════════════════════════════

model KYC {
  id           String    @id @default(cuid())
  userId       String    @unique
  docType      DocType
  firstName    String
  lastName     String
  postName     String?
  dateOfBirth  String?
  docNumber    String?
  address      String?
  docFrontUrl  String
  docBackUrl   String?
  selfieUrl    String
  status       KYCStatus @default(PENDING)
  rejectedNote String?
  reviewedBy   String?
  verifiedAt   DateTime?
  submittedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Brouillon KYC : recto stocké entre /extract et /verify-face (Vercel /tmp non partagé).
model KycDraft {
  userId    String   @id
  docMime   String   @default("image/jpeg")
  docBase64 String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kyc_draft")
}

// ══════════════════════════════════════════════════════════════════════════
// CONVENTION DE COMPTE-TITRES — art. 66 loi 22/069 + Code du numérique
// ══════════════════════════════════════════════════════════════════════════

/// Version publiée du texte de convention (tenue au nom de la banque partenaire).
model SecuritiesAccountConvention {
  id              String   @id @default(cuid())
  version         String   @unique
  title           String
  partnerBankName String
  bodyMarkdown    String
  effectiveFrom   DateTime @default(now())
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agreements SecuritiesAccountAgreement[]

  @@map("securities_account_convention")
}

/// Acceptation / signature électronique d'un utilisateur pour une version donnée.
model SecuritiesAccountAgreement {
  id                 String   @id @default(cuid())
  userId             String
  conventionId       String
  /// Banque choisie pour la tenue du compte-titres (ex. EQUITY_BCDC).
  partnerBankCode    String
  partnerBankName    String
  signedName         String
  signatureMethod    String   @default("TYPED")
  signatureHash      String
  signatureImagePath String?
  /// Contenu PDF (base64) — requis sur Vercel où /tmp est éphémère.
  pdfBase64          String?  @db.Text
  /// PNG signature manuscrite (base64), si méthode DRAWN.
  signatureImageBase64 String? @db.Text
  pdfPath            String
  pdfSha256          String
  ipAddress          String?
  userAgent          String?
  acceptedTerms      Boolean  @default(true)
  signedAt           DateTime @default(now())
  createdAt          DateTime @default(now())

  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  convention SecuritiesAccountConvention @relation(fields: [conventionId], references: [id])

  @@unique([userId, conventionId])
  @@index([userId, signedAt])
  @@map("securities_account_agreement")
}

// ══════════════════════════════════════════════════════════════════════════
// WALLET — solde par devise
// ══════════════════════════════════════════════════════════════════════════

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  currency  Currency
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, currency])
}

// ══════════════════════════════════════════════════════════════════════════
// COMPTES DE PAIEMENT — Mobile Money et bancaire
// ══════════════════════════════════════════════════════════════════════════

model MomoAccount {
  id          String       @id @default(cuid())
  userId      String
  operator    MomoOperator
  phoneNumber String
  accountName String
  isVerified  Boolean      @default(false)
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([userId, operator, phoneNumber])
}

model BankAccount {
  id            String      @id @default(cuid())
  userId        String
  bankName      String
  accountNumber String
  accountName   String
  currency      Currency
  channel       BankChannel
  isVerified    Boolean     @default(false)
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([userId, accountNumber, currency])
}

// ══════════════════════════════════════════════════════════════════════════
// PROFIL DE RÈGLEMENT — canal préféré MoMo / RIB pour souscriptions
// ══════════════════════════════════════════════════════════════════════════

model SettlementProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  preferredChannel  PaymentChannel  @default(MOBILE_MONEY)
  momoPhone         String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settlement_profile")
}

// ══════════════════════════════════════════════════════════════════════════
// PRODUIT — Bon du Trésor (BT) ou Obligation du Trésor (OT)
// ══════════════════════════════════════════════════════════════════════════

model Product {
  id                   String           @id @default(cuid())
  code                 String           @unique
  type                 ProductType
  currency             Currency
  faceValue            Decimal          @db.Decimal(18, 2)
  minTicket            Decimal          @db.Decimal(18, 2)
  discountRate         Decimal?         @db.Decimal(8, 4)
  couponRate           Decimal?         @db.Decimal(8, 4)
  couponFrequency      CouponFrequency?
  issuanceDate         DateTime
  maturityDate         DateTime
  adjudicationDate     DateTime
  subscriptionDeadline DateTime
  totalVolume          Decimal          @db.Decimal(18, 2)
  allocatedVolume      Decimal          @default(0) @db.Decimal(18, 2)
  status               ProductStatus    @default(DRAFT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  subscriptions Subscription[]
  coupons       Coupon[]
}

// ══════════════════════════════════════════════════════════════════════════
// SOUSCRIPTION — un compte de souscription par souscription
// ══════════════════════════════════════════════════════════════════════════

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  productId       String
  amount          Decimal            @db.Decimal(18, 2)
  currency        Currency
  units           Int
  paymentChannel  PaymentChannel
  momoAccountId   String?
  bankAccountId   String?
  bankTransferRef String?            @unique
  paymentRef      String?            @unique
  status          SubscriptionStatus @default(PENDING_PAYMENT)

  adjudicatedAmount Decimal?  @db.Decimal(18, 2)
  adjudicatedRate   Decimal?  @db.Decimal(8, 4)
  adjudicatedAt     DateTime?
  reimbursedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  momoAccount  MomoAccount?  @relation(fields: [momoAccountId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  transactions Transaction[]
  coupons      Coupon[]
}

// ══════════════════════════════════════════════════════════════════════════
// TRANSACTION — tout mouvement d'argent
// ══════════════════════════════════════════════════════════════════════════

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  walletId       String
  subscriptionId String?
  type           TransactionType
  amount         Decimal           @db.Decimal(18, 2)
  currency       Currency
  paymentChannel PaymentChannel?
  reference      String?           @unique
  externalRef    String?
  status         TransactionStatus @default(PENDING)
  failureReason  String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  wallet       Wallet        @relation(fields: [walletId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════
// COUPON — versement d'intérêts (Obligations du Trésor uniquement)
// ══════════════════════════════════════════════════════════════════════════

model Coupon {
  id             String       @id @default(cuid())
  productId      String
  subscriptionId String
  amount         Decimal      @db.Decimal(18, 2)
  currency       Currency
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  paidAt         DateTime?
  status         CouponStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  product      Product      @relation(fields: [productId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════
// TAUX DE CHANGE — référentiel informatif (ekonzo ne convertit jamais)
// ══════════════════════════════════════════════════════════════════════════

model ExchangeRate {
  id      String   @id @default(cuid())
  fromCcy Currency
  toCcy   Currency
  rate    Decimal  @db.Decimal(12, 4)
  source  String
  date    DateTime @default(now())

  @@index([fromCcy, toCcy, date])
}

// ══════════════════════════════════════════════════════════════════════════
// NOTIFICATION
// ══════════════════════════════════════════════════════════════════════════

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════
// AUDIT & SÉCURITÉ
// ══════════════════════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  identifier String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════

enum UserRole {
  CLIENT
  ADMIN
  SUPER_ADMIN
}

enum Currency {
  CDF
  USD
}

enum DocType {
  CNI
  PASSPORT
  PERMIS
}

enum KYCStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  UNDER_REVIEW
  APPROVED
}

enum ProductType {
  BT
  OT
}

enum ProductStatus {
  DRAFT
  OPEN
  CLOSED
  ADJUDICATED
  ACTIVE
  MATURED
}

enum CouponFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  AT_MATURITY
}

enum CouponStatus {
  PENDING
  PAID
  LATE
}

enum MomoOperator {
  AIRTEL
  ORANGE
  MPESA
}

enum BankChannel {
  SIMAD
  SWIFT
}

enum PaymentChannel {
  MOBILE_MONEY
  BANK_TRANSFER
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  SUBMITTED
  ADJUDICATED
  PARTIALLY_ADJUDICATED
  ACTIVE
  REIMBURSED
  CANCELLED
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SUBSCRIPTION
  COUPON
  REIMBURSEMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  PRODUCT_OPEN
  SUBSCRIPTION_DEADLINE
  PAYMENT_CONFIRMED
  ADJUDICATION_RESULT
  COUPON_PAID
  MATURITY_REMINDER
  REIMBURSEMENT_DONE
  KYC_STATUS_CHANGED
}
