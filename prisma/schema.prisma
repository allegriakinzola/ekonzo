// ekonzo — schéma de base de données
// Plateforme de souscription aux Bons et Obligations du Trésor de la RDC
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════════════════
// BETTER AUTH — tables gérées par la librairie d'authentification
// ══════════════════════════════════════════════════════════════════════════

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                UserRole  @default(CLIENT)
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  wallets       Wallet[]
  momoAccounts  MomoAccount[]
  bankAccounts  BankAccount[]
  subscriptions           Subscription[]
  transactions            Transaction[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  settlementProfile       SettlementProfile?
  partnerBank             PartnerBank?
  bankLink                BankLink?

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ══════════════════════════════════════════════════════════════════════════
// WALLET — solde par devise
// ══════════════════════════════════════════════════════════════════════════

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  currency  Currency
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, currency])
}

// ══════════════════════════════════════════════════════════════════════════
// COMPTES DE PAIEMENT — Mobile Money et bancaire
// ══════════════════════════════════════════════════════════════════════════

model MomoAccount {
  id          String       @id @default(cuid())
  userId      String
  operator    MomoOperator
  phoneNumber String
  accountName String
  isVerified  Boolean      @default(false)
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([userId, operator, phoneNumber])
}

model BankAccount {
  id            String      @id @default(cuid())
  userId        String
  bankName      String
  accountNumber String
  accountName   String
  currency      Currency
  channel       BankChannel
  isVerified    Boolean     @default(false)
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([userId, accountNumber, currency])
}

// ══════════════════════════════════════════════════════════════════════════
// PROFIL DE RÈGLEMENT — canal préféré MoMo / RIB pour souscriptions
// ══════════════════════════════════════════════════════════════════════════

model SettlementProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  preferredChannel  PaymentChannel  @default(MOBILE_MONEY)
  momoPhone         String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settlement_profile")
}

// ══════════════════════════════════════════════════════════════════════════
// PRODUIT — Annonce d'adjudication BT / OT (Ministère des Finances)
// ══════════════════════════════════════════════════════════════════════════

model Product {
  id                   String           @id @default(cuid())
  code                 String           @unique
  /** BT | OT — dérivé de instrumentType (compat) */
  type                 ProductType
  /** BTI | BT_USD | OTI | OT_USD */
  instrumentType       InstrumentType?
  currency             Currency
  /** Code ISIN de la ligne */
  isin                 String?
  /** Ligne à ouvrir (ex. BTI 6 mois 3 mars 2026) */
  lineLabel            String?
  /** Nominal unitaire : 100 000 FC ou 10 USD */
  faceValue            Decimal          @db.Decimal(18, 2)
  /** Minimum de souscription = 10 × faceValue */
  minTicket            Decimal          @db.Decimal(18, 2)
  /** Taux annoncé par le MinFi (BT et OT) — fraction ex. 0.09 = 9 % */
  announcedRate        Decimal?         @db.Decimal(8, 4)
  /** @deprecated compat — miroir de announcedRate pour BT */
  discountRate         Decimal?         @db.Decimal(8, 4)
  /** @deprecated compat — miroir de announcedRate pour OT */
  couponRate           Decimal?         @db.Decimal(8, 4)
  couponFrequency      CouponFrequency?
  /** Nombre de paiements d'intérêts par an (OT, ex. 4 = trimestriel) */
  interestPeriodsPerYear Int?
  /** Modalités de remboursement du principal (OT) */
  principalRepaymentMode PrincipalRepaymentMode?
  issuanceDate         DateTime
  maturityDate         DateTime
  adjudicationDate     DateTime
  /** Date limite de présentation des soumissions / ordres */
  subscriptionDeadline DateTime
  resultsDate          DateTime?
  settlementDate       DateTime?
  totalVolume          Decimal          @db.Decimal(18, 2)
  allocatedVolume      Decimal          @default(0) @db.Decimal(18, 2)
  status               ProductStatus    @default(DRAFT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  subscriptions Subscription[]
  coupons       Coupon[]
}

// ══════════════════════════════════════════════════════════════════════════
// SOUSCRIPTION — un compte de souscription par souscription
// ══════════════════════════════════════════════════════════════════════════

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  productId       String
  /** Montant nominal souscrit (units × faceValue) */
  amount          Decimal            @db.Decimal(18, 2)
  /** Montant à régler à la banque (BT : précompté ; OT : au pair) */
  settlementAmount Decimal?          @db.Decimal(18, 2)
  currency        Currency
  units           Int
  paymentChannel  PaymentChannel
  momoAccountId   String?
  bankAccountId   String?
  bankTransferRef String?            @unique
  paymentRef      String?            @unique
  status          SubscriptionStatus @default(PENDING_PAYMENT)

  adjudicatedAmount Decimal?  @db.Decimal(18, 2)
  adjudicatedRate   Decimal?  @db.Decimal(8, 4)
  adjudicatedAt     DateTime?
  reimbursedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  momoAccount  MomoAccount?  @relation(fields: [momoAccountId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  transactions Transaction[]
  coupons      Coupon[]
  paymentSession BankPaymentSession?
}

// ══════════════════════════════════════════════════════════════════════════
// TRANSACTION — tout mouvement d'argent
// ══════════════════════════════════════════════════════════════════════════

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  walletId       String
  subscriptionId String?
  type           TransactionType
  amount         Decimal           @db.Decimal(18, 2)
  currency       Currency
  paymentChannel PaymentChannel?
  reference      String?           @unique
  externalRef    String?
  status         TransactionStatus @default(PENDING)
  failureReason  String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  wallet       Wallet        @relation(fields: [walletId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════
// COUPON — versement d'intérêts (Obligations du Trésor uniquement)
// ══════════════════════════════════════════════════════════════════════════

model Coupon {
  id             String       @id @default(cuid())
  productId      String
  subscriptionId String
  amount         Decimal      @db.Decimal(18, 2)
  currency       Currency
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  paidAt         DateTime?
  status         CouponStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  product      Product      @relation(fields: [productId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════
// TAUX DE CHANGE — référentiel informatif (ekonzo ne convertit jamais)
// ══════════════════════════════════════════════════════════════════════════

model ExchangeRate {
  id      String   @id @default(cuid())
  fromCcy Currency
  toCcy   Currency
  rate    Decimal  @db.Decimal(12, 4)
  source  String
  date    DateTime @default(now())

  @@index([fromCcy, toCcy, date])
}

// ══════════════════════════════════════════════════════════════════════════
// NOTIFICATION
// ══════════════════════════════════════════════════════════════════════════

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════
// AUDIT & SÉCURITÉ
// ══════════════════════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  identifier String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════
// BANQUES COMMERCIALES PARTENAIRES — gérées par le Ministère
// ══════════════════════════════════════════════════════════════════════════

model PartnerBank {
  id                String          @id @default(cuid())
  code              String          @unique
  name              String
  shortName         String
  email             String          @unique
  logoUrl           String?
  isActive          Boolean         @default(true)
  userId            String?         @unique
  invitedAt         DateTime?
  activatedAt       DateTime?
  /** Identifiants OAuth pour interop ekonzo ↔ banque */
  oauthClientId     String?
  oauthClientSecret String?
  /** SIMULATED = IdP hébergé sur ekonzo ; EXTERNAL = URLs banque réelle */
  interopMode       BankInteropMode @default(SIMULATED)
  authorizeUrl      String?
  tokenUrl          String?
  userinfoUrl       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user         User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  invites      BankInviteToken[]
  customers    BankCustomer[]
  links        BankLink[]
  oauthSessions BankOAuthSession[]
  paymentSessions BankPaymentSession[]

  @@map("partner_bank")
}

model BankInviteToken {
  id        String    @id @default(cuid())
  bankId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  bank PartnerBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
  @@map("bank_invite_token")
}

/** Clients bancaires simulés (internet banking) — gérés dans l'espace banque */
model BankCustomer {
  id            String   @id @default(cuid())
  partnerBankId String
  email         String
  passwordHash  String
  fullName      String
  accountNumber String
  accountName   String
  currency      Currency @default(CDF)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partnerBank PartnerBank @relation(fields: [partnerBankId], references: [id], onDelete: Cascade)

  @@unique([partnerBankId, email])
  @@unique([partnerBankId, accountNumber])
  @@index([partnerBankId])
  @@map("bank_customer")
}

/** Liaison active User ekonzo ↔ une banque partenaire (une seule à la fois) */
model BankLink {
  id             String   @id @default(cuid())
  userId         String   @unique
  partnerBankId  String
  bankCustomerId String
  customerEmail  String
  fullName       String
  accountNumber  String
  accountName    String
  currency       Currency
  linkedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerBank PartnerBank @relation(fields: [partnerBankId], references: [id], onDelete: Restrict)

  @@index([partnerBankId])
  @@map("bank_link")
}

/** Session OAuth Authorization Code (interop) */
model BankOAuthSession {
  id             String    @id @default(cuid())
  partnerBankId  String
  userId         String
  state          String    @unique
  redirectUri    String
  code           String?   @unique
  codeExpiresAt  DateTime?
  accessToken    String?   @unique
  tokenExpiresAt DateTime?
  bankCustomerId String?
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  partnerBank PartnerBank @relation(fields: [partnerBankId], references: [id], onDelete: Cascade)

  @@index([partnerBankId])
  @@index([userId])
  @@map("bank_oauth_session")
}

/** Session de paiement interop ekonzo ↔ banque (souscription titres publics) */
model BankPaymentSession {
  id             String            @id @default(cuid())
  partnerBankId  String
  userId         String
  subscriptionId String            @unique
  /** Jeton opaque pour l'UI banque /pay */
  token          String            @unique
  amount         Decimal           @db.Decimal(18, 2)
  currency       Currency
  productLabel   String
  instrumentKind String
  accountNumber  String
  accountName    String
  status         BankPaymentStatus @default(PENDING)
  /** Moyen de paiement choisi côté banque */
  method         BankPaymentMethod @default(BANK_ACCOUNT)
  /** Mobile Money (via agrégateur de la banque — simulé EasyPay) */
  momoPhone       String?
  momoOrderRef    String?
  momoProviderRef String?
  momoStatus      String?
  failureReason   String?
  notifyRef      String?
  paidAt         DateTime?
  returnUrl      String
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  partnerBank  PartnerBank  @relation(fields: [partnerBankId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([partnerBankId])
  @@index([userId])
  @@index([token])
  @@index([momoOrderRef])
  @@index([momoProviderRef])
  @@map("bank_payment_session")
}

// ══════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════

enum BankInteropMode {
  SIMULATED
  EXTERNAL
}

enum BankPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum BankPaymentMethod {
  BANK_ACCOUNT
  MOBILE_MONEY
}

enum UserRole {
  CLIENT
  BANK
  ADMIN
  SUPER_ADMIN
}

enum Currency {
  CDF
  USD
}

enum ProductType {
  BT
  OT
}

enum InstrumentType {
  BTI
  BT_USD
  OTI
  OT_USD
}

enum PrincipalRepaymentMode {
  AT_MATURITY
  SEMI_ANNUAL
  ANNUAL
}

enum ProductStatus {
  DRAFT
  OPEN
  CLOSED
  ADJUDICATED
  ACTIVE
  MATURED
}

enum CouponFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  AT_MATURITY
}

enum CouponStatus {
  PENDING
  PAID
  LATE
}

enum MomoOperator {
  AIRTEL
  ORANGE
  MPESA
}

enum BankChannel {
  SIMAD
  SWIFT
}

enum PaymentChannel {
  MOBILE_MONEY
  BANK_TRANSFER
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  SUBMITTED
  ADJUDICATED
  PARTIALLY_ADJUDICATED
  ACTIVE
  REIMBURSED
  CANCELLED
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SUBSCRIPTION
  COUPON
  REIMBURSEMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  PRODUCT_OPEN
  SUBSCRIPTION_DEADLINE
  PAYMENT_CONFIRMED
  ADJUDICATION_RESULT
  COUPON_PAID
  MATURITY_REMINDER
  REIMBURSEMENT_DONE
}
